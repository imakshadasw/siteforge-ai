generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             Int      @id @default(autoincrement())

  businessName   String
  businessType   String
  city           String
  description    String

  theme          String   @default("Dark")

  heroTitle      String
  heroSubtitle   String
  about          String

  services       Json
  whyChooseUs    Json

  testimonials   Json

  phone          String?
  email          String?
  address        String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}